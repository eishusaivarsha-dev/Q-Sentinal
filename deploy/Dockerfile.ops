# Advisory ops-plane image (scikit-learn lives here, never in the API image). Reads the API over HTTP.
FROM python:3.11-slim

WORKDIR /ops
COPY ops/ ./
RUN pip install --no-cache-dir .

ENV QSENTINEL_API_URL=http://api:8000
EXPOSE 8100
CMD ["uvicorn", "qsentinel_ops.server:app", "--host", "0.0.0.0", "--port", "8100"]
